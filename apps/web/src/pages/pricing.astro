---
import Base from "../layouts/Base.astro";
import { LIMITS, PRICES, PRODUCTS, PRODUCT_COPY } from "@plinth/shared";
---

<Base title="Plinth pricing" description="Free, Pro $19/mo, Team $49/mo per product. Polar handles tax. Annual = 10 months." path="/pricing">
  <h1>Pricing that stays free until revenue says otherwise</h1>
  <p class="lede">Every product has a free quota. Pro and Team unlock memory, private bins, webhooks, and replay. Billed through Polar. Annual is 10× monthly (2 months free).</p>

  <div class="plans">
    <article class="plot-window" data-plan-card="free">
      <p class="index-num">Free</p>
      <h2>$0</h2>
      <ul>
        <li>No account required for first success</li>
        <li>Forms: {LIMITS.free.forms.monthlyQuota}/mo · 1 form</li>
        <li>Catch: {LIMITS.free.catch.monthlyQuota} events · 1 bin · 24h</li>
        <li>Schema: {LIMITS.free.schema.dailyQuota}/day</li>
      </ul>
    </article>
    <article class="plot-window lift" data-plan-card="pro">
      <p class="index-num">Pro</p>
      <h2>{PRICES.pro.label}/mo · ${PRICES.pro.annual / 100}/yr</h2>
      <ul>
        <li>Forms: {LIMITS.pro.forms.monthlyQuota}/mo · webhooks</li>
        <li>Catch: {LIMITS.pro.catch.resources} bins · replay · private</li>
        <li>Schema: {LIMITS.pro.schema.dailyQuota}/day · saved schemas</li>
      </ul>
      <div class="buy-col">
        {PRODUCTS.map((p) => (
          <button class="mark-btn" type="button" data-product={p} data-plan="pro" id={`btn-${p}-pro`}>
            Buy {PRODUCT_COPY[p].name} Pro
          </button>
        ))}
      </div>
    </article>
    <article class="plot-window" data-plan-card="team">
      <p class="index-num">Team</p>
      <h2>{PRICES.team.label}/mo · ${PRICES.team.annual / 100}/yr</h2>
      <ul>
        <li>Higher quotas across the board</li>
        <li>90-day Catch retention</li>
        <li>Same Polar checkout, same API keys</li>
      </ul>
      <div class="buy-col">
        {PRODUCTS.map((p) => (
          <button class="mark-btn secondary" type="button" data-product={p} data-plan="team" id={`btn-${p}-team`}>
            Buy {PRODUCT_COPY[p].name} Team
          </button>
        ))}
      </div>
    </article>
  </div>

  <section class="plot-window" style="margin-top:2rem;overflow-x:auto">
    <h2>Quota chart</h2>
    <table class="table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Free</th>
          <th>Pro</th>
          <th>Team</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Forms / mo</td>
          <td class="ghost-opt">{LIMITS.free.forms.monthlyQuota}</td>
          <td>{LIMITS.pro.forms.monthlyQuota}</td>
          <td>{LIMITS.team.forms.monthlyQuota}</td>
        </tr>
        <tr>
          <td>Catch events</td>
          <td class="ghost-opt">{LIMITS.free.catch.monthlyQuota}</td>
          <td>{LIMITS.pro.catch.monthlyQuota}</td>
          <td>{LIMITS.team.catch.monthlyQuota}</td>
        </tr>
        <tr>
          <td>Schema / day</td>
          <td class="ghost-opt">{LIMITS.free.schema.dailyQuota}</td>
          <td>{LIMITS.pro.schema.dailyQuota}</td>
          <td>{LIMITS.team.schema.dailyQuota}</td>
        </tr>
        <tr>
          <td>Catch retention</td>
          <td class="ghost-opt">{LIMITS.free.catch.retentionDays}d</td>
          <td>{LIMITS.pro.catch.retentionDays}d</td>
          <td>{LIMITS.team.catch.retentionDays}d</td>
        </tr>
      </tbody>
    </table>
  </section>

  <p id="billing-status" class="mono" aria-live="polite" style="margin-top:1rem"></p>
  <p class="prose">Checkout opens on Polar. After payment you land on <a href="/start">/start</a> to claim your API key. Cancel anytime from <a href="/account">Account → Manage billing</a>.</p>
</Base>

<style>
  .plans {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 960px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }
  ul {
    padding-left: 1.1rem;
    color: var(--stone);
  }
  .buy-col {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }
  h2 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-transform: none;
  }
</style>

<script>
  const api = window.PLINTH_API;
  const status = document.getElementById("billing-status");
  const product = new URLSearchParams(location.search).get("product");
  if (product) {
    document.querySelectorAll(`[data-product="${product}"]`).forEach((btn) => btn.classList.add("spotlight"));
    document.querySelector('[data-plan-card="pro"]')?.classList.add("highlight");
    status.textContent = `Highlighted: ${product}. Pick Pro or Team.`;
  }

  document.querySelectorAll("[data-product]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const product = btn.getAttribute("data-product");
      const plan = btn.getAttribute("data-plan");
      status.textContent = "Opening Polar checkout…";
      const res = await fetch(`${api}/v1/checkout`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ product, plan }),
      });
      const data = await res.json();
      if (!res.ok) {
        status.innerHTML = `<span class="status-bad">${data.error || "Billing not configured yet"}</span>`;
        return;
      }
      window.location.href = data.url;
    });
  });
</script>
