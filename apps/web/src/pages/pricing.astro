---
import Base from "../layouts/Base.astro";
import { LIMITS, PRICES, PRODUCTS, PRODUCT_COPY } from "@plinth/shared";
---

<Base title="Plinth pricing" description="Free, Pro $19/mo, Team $49/mo per product. Polar handles tax. Annual = 10 months." path="/pricing">
  <div class="land-band" style="display:inline-block">Dead reckoning</div>
  <h1>Pricing that stays on the free tier until revenue says otherwise</h1>
  <p class="lede">Every product has a free quota. Pro and Team unlock memory, private bins, webhooks, and replay. Billed through Polar (merchant of record). Annual checkout is 10× monthly (2 months free).</p>

  <div class="plans">
    <article class="plot-window" data-plan-card="free">
      <h2>Free</h2>
      <p class="mono">$0</p>
      <ul>
        <li>No account required for first success</li>
        <li>Forms: {LIMITS.free.forms.monthlyQuota}/mo · 1 form</li>
        <li>Catch: {LIMITS.free.catch.monthlyQuota} events · 1 bin · 24h</li>
        <li>Schema: {LIMITS.free.schema.dailyQuota}/day</li>
      </ul>
    </article>
    <article class="plot-window" data-plan-card="pro">
      <h2>Pro</h2>
      <p class="mono">{PRICES.pro.label}/mo · ${PRICES.pro.annual / 100}/yr</p>
      <ul>
        <li>Forms: {LIMITS.pro.forms.monthlyQuota}/mo · webhooks</li>
        <li>Catch: {LIMITS.pro.catch.resources} bins · replay · private</li>
        <li>Schema: {LIMITS.pro.schema.dailyQuota}/day · saved schemas</li>
      </ul>
      <div class="row product-btns" data-tier="pro">
        {PRODUCTS.map((p) => (
          <button class="mark-btn" type="button" data-product={p} data-plan="pro" id={`btn-${p}-pro`}>
            Buy {PRODUCT_COPY[p].name} Pro
          </button>
        ))}
      </div>
      <p class="mono tip">Polar checkout lists monthly and annual prices when both are configured on the product.</p>
    </article>
    <article class="plot-window" data-plan-card="team">
      <h2>Team</h2>
      <p class="mono">{PRICES.team.label}/mo · ${PRICES.team.annual / 100}/yr</p>
      <ul>
        <li>Higher quotas across the board</li>
        <li>90-day Catch retention</li>
        <li>Same Polar checkout, same API keys</li>
      </ul>
      <div class="row product-btns" data-tier="team">
        {PRODUCTS.map((p) => (
          <button class="mark-btn secondary" type="button" data-product={p} data-plan="team" id={`btn-${p}-team`}>
            Buy {PRODUCT_COPY[p].name} Team
          </button>
        ))}
      </div>
    </article>
  </div>
  <p id="billing-status" class="mono" aria-live="polite" style="margin-top:1rem"></p>
  <p class="prose">Checkout opens on Polar. After payment you land on <a href="/start">/start</a> to claim your API key. Cancel anytime from <a href="/account">Account → Manage billing</a>.</p>
</Base>

<style>
  .plans {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  @media (min-width: 960px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  ul {
    padding-left: 1.1rem;
  }
  .tip {
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .plot-window.highlight {
    outline: 2px solid var(--magenta);
    box-shadow: 0 0 0 6px rgba(208, 18, 122, 0.18);
  }
  .mark-btn.spotlight {
    transform: scale(1.03);
    box-shadow: 0 0 0 3px rgba(208, 18, 122, 0.55);
  }
</style>

<script>
  const api = window.PLINTH_API;
  const status = document.getElementById("billing-status");
  const product = new URLSearchParams(location.search).get("product");
  if (product) {
    document.querySelectorAll(`[data-product="${product}"]`).forEach((btn) => btn.classList.add("spotlight"));
    document.querySelector('[data-plan-card="pro"]')?.classList.add("highlight");
    status.textContent = `Highlighted: ${product}. Pick Pro or Team below.`;
  }

  document.querySelectorAll("[data-product]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const product = btn.getAttribute("data-product");
      const plan = btn.getAttribute("data-plan");
      status.textContent = "Opening Polar checkout…";
      const res = await fetch(`${api}/v1/checkout`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ product, plan }),
      });
      const data = await res.json();
      if (!res.ok) {
        status.innerHTML = `<span class="status-bad">${data.error || "Billing not configured yet"}</span>`;
        return;
      }
      window.location.href = data.url;
    });
  });
</script>
