---
import Base from "../../layouts/Base.astro";
---

<Base title="Catch docs — Plinth" path="/docs/catch">
  <p class="land-band">Catch</p>
  <h1>Catch</h1>
  <article class="plot-window prose">
    <h2>Create a bin</h2>
    <pre class="mono code-well">{`POST /v1/catch/bins
{ "name": "stripe-local" }`}</pre>
    <h2>Receive</h2>
    <p>Any method to <code class="inline-code">/v1/catch/:binId</code> is recorded. Authorization headers are redacted.</p>
    <h2>Inspect</h2>
    <pre class="mono code-well">{`GET /v1/catch/:binId/events`}</pre>
    <h2>Replay (Pro)</h2>
    <pre class="mono code-well">{`POST /v1/catch/:binId/replay/:eventId
{ "url": "https://localhost:3000/webhook" }`}</pre>
  </article>
</Base>

<style>
  .code-well {
    background: #0a0b0d;
    padding: 1rem;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px var(--hair);
    margin: 1rem 0;
    color: var(--snow);
  }
</style>
