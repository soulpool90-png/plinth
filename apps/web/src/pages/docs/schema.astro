---
import Base from "../../layouts/Base.astro";
---

<Base title="Schema docs — Plinth" path="/docs/schema">
  <p class="land-band">Schema</p>
  <h1>Schema</h1>
  <article class="plot-window prose">
    <h2>Repair</h2>
    <pre class="mono code-well">{`POST /v1/schema/repair
{ "text": "\`\`\`json\\n{ok: True,}\\n\`\`\`" }`}</pre>
    <h2>Validate</h2>
    <pre class="mono code-well">{`POST /v1/schema/validate
{ "value": { "ok": true }, "schema": { "type": "object" } }`}</pre>
    <h2>Repair and validate</h2>
    <pre class="mono code-well">{`POST /v1/schema/repair-and-validate
{ "text": "{ok: True}", "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } }`}</pre>
    <p>Library: <code class="inline-code">npm i @plinth/schema</code></p>
  </article>
</Base>

<style>
  .code-well {
    background: #0a0b0d;
    padding: 1rem;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px var(--hair);
    margin: 1rem 0;
    color: var(--snow);
  }
</style>
