---
import Base from "../layouts/Base.astro";
import SchemaBench from "../components/SchemaBench.astro";
import Ridge from "../components/Ridge.astro";
---

<Base title="Plinth — infrastructure under the thing you ship" path="/">
  <section class="hero">
    <div class="hero-sky">
      <h1 class="ridge-rise">Infrastructure under the thing you ship</h1>
      <p class="lede">
        A form endpoint, a webhook inbox you can read, and JSON repair that survives LLM output.
        Free path works without an account. Paid is memory and limits.
      </p>
      <div class="row" style="margin-top:1.5rem">
        <a class="mark-btn" href="#plot">Repair broken JSON</a>
        <a class="mark-btn secondary" href="/pricing">Pricing</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <picture>
        <source media="(max-width: 760px)" srcset="/art/ridge-mobile.png" />
        <img class="ridge-img ridge-rise" src="/art/ridge-hero.png" alt="" width="1600" height="900" />
      </picture>
      <div class="mist-fade"></div>
    </div>
  </section>

  <section id="plot" class="bench-slot">
    <SchemaBench />
  </section>

  <Ridge />

  <section class="stack" style="margin-top:1.5rem">
    <ol class="product-index" aria-label="Products">
      <li><a href="/forms"><span class="index-num">01</span> <strong>Forms</strong> — static-site POST URL</a></li>
      <li><a href="/catch"><span class="index-num">02</span> <strong>Catch</strong> — inspectable webhook bin</a></li>
      <li><a href="/schema"><span class="index-num">03</span> <strong>Schema</strong> — repair + validate</a></li>
    </ol>
  </section>

  <section style="margin-top:3rem" class="stack">
    <h2>Three tools. One foundation.</h2>
    <div class="tri">
      <article class="plot-window">
        <p class="index-num">01</p>
        <h3>Forms</h3>
        <p>Point any HTML form at a Plinth URL. Honeypot + heuristics. Store or forward. Open-source screener in <code class="inline-code">@plinth/forms</code>.</p>
        <a href="/forms">Open Forms →</a>
      </article>
      <article class="plot-window">
        <p class="index-num">02</p>
        <h3>Catch</h3>
        <p>Create a bin. Fire Stripe, GitHub, or your own webhook at it. Inspect headers and body. Replay on Pro.</p>
        <a href="/catch">Open Catch →</a>
      </article>
      <article class="plot-window">
        <p class="index-num">03</p>
        <h3>Schema</h3>
        <p>Repair trailing commas, fences, Python literals, truncated braces — then validate against JSON Schema.</p>
        <a href="/schema">Open Schema →</a>
      </article>
    </div>
  </section>

  <section style="margin-top:3rem" class="plot-window">
    <p>
      Free quotas on every product. Pro is <strong>$19/mo</strong>. Team is <strong>$49/mo</strong>. Polar handles
      tax and receipts. Annual = 10 months.
    </p>
    <a class="mark-btn" href="/pricing">Full pricing</a>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(58vh, 560px);
    display: grid;
    align-content: start;
    padding-top: 1.25rem;
    padding-bottom: 7rem;
    overflow: hidden;
  }
  .hero-sky {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }
  .hero-art {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(1100px, 100vw);
    z-index: 1;
    pointer-events: none;
  }
  .ridge-img {
    width: 100%;
    height: auto;
    opacity: 0.85;
  }
  .mist-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--ground) 0%, transparent 35%, transparent 55%, var(--ground) 100%);
  }
  .bench-slot {
    position: relative;
    z-index: 3;
    margin-top: -2.5rem;
  }
  .ridge-rise {
    animation: rise 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .product-index {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    background: var(--ground);
  }
  .product-index li {
    border-top: 1px solid var(--hair);
  }
  .product-index li:last-child {
    border-bottom: 1px solid var(--hair);
  }
  .product-index a {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    color: var(--snow);
    text-decoration: none;
    font-family: var(--font-display);
  }
  .product-index a:hover {
    color: var(--mist);
  }
  .product-index strong {
    color: var(--snow);
    font-weight: 600;
  }
  .tri {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 860px) {
    .tri {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
