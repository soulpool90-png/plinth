---
import Base from "../../layouts/Base.astro";
import { GUIDES } from "./_guides";

const categories = ["Forms", "Catch", "Schema", "Platform"] as const;
const byCategory = categories.map((cat) => ({
  name: cat,
  guides: GUIDES.filter((g) => g.category === cat),
}));
---

<Base
  title="Guides — Plinth"
  description="Practical guides for static site forms, webhook testing, and LLM JSON repair on Plinth."
  path="/guides"
>
  <p class="land-band">Guides</p>
  <h1>Guides</h1>
  <p class="lede">
    Long-form notes for solo builders — contact forms without a server, webhook capture and replay, and JSON repair for agent pipelines.
  </p>

  {byCategory.map(({ name, guides }) => (
    <section class="plot-window prose guide-section">
      <h2>{name}</h2>
      <ul class="guide-index">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`}><strong>{g.title}</strong></a>
            <p>{g.description}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <nav class="read-footer">
    <a href="/docs">All docs</a>
    <span aria-hidden="true">·</span>
    <a href="/forms">Forms</a>
    <span aria-hidden="true">·</span>
    <a href="/catch">Catch</a>
    <span aria-hidden="true">·</span>
    <a href="/schema">Schema</a>
    <span aria-hidden="true">·</span>
    <a href="/pricing">Pricing</a>
  </nav>
</Base>

<style>
  .guide-section {
    margin-top: 2rem;
  }

  .guide-index {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .guide-index li {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--hair);
  }

  .guide-index li:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .guide-index p {
    margin: 0.35rem 0 0;
    color: var(--stone);
    font-size: 0.95rem;
  }

  .read-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }

  .read-footer span {
    color: var(--stone);
    opacity: 0.5;
  }
</style>
