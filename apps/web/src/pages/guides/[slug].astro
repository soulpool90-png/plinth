---
import Base from "../../layouts/Base.astro";
import { GUIDES } from "./_guides";

export function getStaticPaths() {
  return GUIDES.map((g) => ({
    params: { slug: g.slug },
    props: {
      slug: g.slug,
      title: g.title,
      description: g.description,
      category: g.category,
      htmlBody: g.htmlBody,
    },
  }));
}

const { title, description, category, htmlBody, slug } = Astro.props;
const related = GUIDES.filter((g) => g.slug !== slug && g.category === category).slice(0, 4);
const cross = GUIDES.filter((g) => g.slug !== slug && g.category !== category).slice(0, 2);
---

<Base title={`${title} — Plinth`} description={description} path={`/guides/${slug}`}>
  <div class="land-band" style="display:inline-block">Guide · {category}</div>
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <div class="prose guide-body" set:html={htmlBody} />
  {(related.length > 0 || cross.length > 0) && (
    <section class="prose" style="margin-top:2.5rem">
      <h2>More guides</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`}>{g.title}</a>
          </li>
        ))}
        {cross.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`}>{g.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .guide-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .guide-body :global(th),
  .guide-body :global(td) {
    border: 1px solid rgba(10, 95, 107, 0.35);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .guide-body :global(pre) {
    background: #063a42;
    padding: 1rem;
    overflow-x: auto;
    border-radius: 2px;
  }
  .guide-body :global(pre code) {
    font-family: "Spline Sans Mono", ui-monospace, monospace;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .guide-body :global(.guide-related) {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(10, 95, 107, 0.25);
  }
</style>
