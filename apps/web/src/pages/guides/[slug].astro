---
import Base from "../../layouts/Base.astro";
import { GUIDES } from "./_guides";

export function getStaticPaths() {
  return GUIDES.map((g) => ({
    params: { slug: g.slug },
    props: {
      slug: g.slug,
      title: g.title,
      description: g.description,
      category: g.category,
      htmlBody: g.htmlBody,
    },
  }));
}

const { title, description, category, htmlBody, slug } = Astro.props;
const related = GUIDES.filter((g) => g.slug !== slug && g.category === category).slice(0, 4);
const cross = GUIDES.filter((g) => g.slug !== slug && g.category !== category).slice(0, 2);
---

<Base title={`${title} — Plinth`} description={description} path={`/guides/${slug}`}>
  <p class="land-band">{category}</p>
  <h1>{title}</h1>
  <p class="lede">{description}</p>
  <article class="plot-window prose guide-body" set:html={htmlBody} />
  {(related.length > 0 || cross.length > 0) && (
    <section class="plot-window prose read-more">
      <h2>More guides</h2>
      <ul>
        {related.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`}>{g.title}</a>
          </li>
        ))}
        {cross.map((g) => (
          <li>
            <a href={`/guides/${g.slug}`}>{g.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .read-more {
    margin-top: 2.5rem;
  }

  .guide-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  .guide-body :global(th),
  .guide-body :global(td) {
    border-bottom: 1px solid var(--hair);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .guide-body :global(th) {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
    font-weight: 500;
    font-size: 0.72rem;
  }

  .guide-body :global(pre) {
    background: #0a0b0d;
    padding: 1rem;
    overflow-x: auto;
    box-shadow: inset 0 0 0 1px var(--hair);
    margin: 1rem 0;
    color: var(--snow);
  }

  .guide-body :global(pre code) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    background: transparent;
    padding: 0;
    box-shadow: none;
    color: inherit;
  }

  .guide-body :global(.guide-related) {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hair);
  }
</style>
