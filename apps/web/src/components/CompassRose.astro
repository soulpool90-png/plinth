---
interface Props {
  size?: number;
}
const { size = 280 } = Astro.props;
---

<svg
  class="rose"
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="Compass rose"
>
  <circle cx="100" cy="100" r="92" fill="none" stroke="rgba(243,247,248,0.25)" stroke-width="1"></circle>
  <circle cx="100" cy="100" r="70" fill="none" stroke="rgba(243,247,248,0.18)" stroke-width="1" stroke-dasharray="2 4"></circle>
  {
    Array.from({ length: 16 }).map((_, i) => {
      const a = (i * Math.PI) / 8;
      const x1 = 100 + Math.cos(a) * 78;
      const y1 = 100 + Math.sin(a) * 78;
      const x2 = 100 + Math.cos(a) * 92;
      const y2 = 100 + Math.sin(a) * 92;
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(243,247,248,0.35)" stroke-width="1"></line>;
    })
  }
  <g class="rose-spin">
    <path d="M100 18 L108 92 L182 100 L108 108 L100 182 L92 108 L18 100 L92 92 Z" fill="#d0127a"></path>
    <path d="M100 40 L104 96 L160 100 L104 104 L100 160 L96 104 L40 100 L96 96 Z" fill="#f3f7f8"></path>
    <circle cx="100" cy="100" r="6" fill="#063a42"></circle>
  </g>
  <text x="100" y="14" text-anchor="middle" fill="#f3f7f8" font-size="10" font-family="Geologica,sans-serif">N</text>
</svg>

<style>
  .rose {
    filter: drop-shadow(0 12px 24px rgba(4, 30, 36, 0.35));
  }
  .rose-spin {
    transform-origin: 100px 100px;
    animation: settle 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes settle {
    from {
      transform: rotate(-28deg);
      opacity: 0.4;
    }
    to {
      transform: rotate(0deg);
      opacity: 1;
    }
  }
</style>
