---
interface Props {
  size?: number;
}
const { size = 280 } = Astro.props;
---

<svg
  class="rose"
  width={size}
  height={size}
  viewBox="0 0 200 200"
  role="img"
  aria-label="Compass rose"
>
  <circle cx="100" cy="100" r="90" fill="none" stroke="rgba(242,241,236,0.18)" stroke-width="1"></circle>
  <circle cx="100" cy="100" r="68" fill="none" stroke="rgba(138,143,150,0.35)" stroke-width="1" stroke-dasharray="2 5"></circle>
  {
    Array.from({ length: 16 }).map((_, i) => {
      const a = (i * Math.PI) / 8;
      const x1 = 100 + Math.cos(a) * 76;
      const y1 = 100 + Math.sin(a) * 76;
      const x2 = 100 + Math.cos(a) * 90;
      const y2 = 100 + Math.sin(a) * 90;
      return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(138,143,150,0.4)" stroke-width="1"></line>;
    })
  }
  <g class="rose-spin">
    <path
      d="M100 22 L106 94 L178 100 L106 106 L100 178 L94 106 L22 100 L94 94 Z"
      fill="none"
      stroke="#f2f1ec"
      stroke-width="1.5"
    ></path>
    <circle cx="100" cy="100" r="4" fill="#f2f1ec"></circle>
  </g>
  <text
    x="100"
    y="14"
    text-anchor="middle"
    fill="#8a8f96"
    font-size="9"
    font-family="Geist Mono, monospace"
    letter-spacing="2">N</text>
</svg>

<style>
  .rose-spin {
    transform-origin: 100px 100px;
    animation: settle 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: rotate(-18deg);
    }
    to {
      opacity: 1;
      transform: rotate(0deg);
    }
  }
</style>
