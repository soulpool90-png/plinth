---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "Plinth — forms, webhook catch, JSON repair",
  description = "Open-core infrastructure for solo builders. A form endpoint, an inspectable webhook inbox, and LLM JSON repair — on Cloudflare, billed through Polar.",
  path = "/",
} = Astro.props;

const canonical = new URL(path, "https://plinthrun.com").toString();
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://api.plinthrun.com";
const nav = [
  { href: "/forms", label: "Forms" },
  { href: "/catch", label: "Catch" },
  { href: "/schema", label: "Schema" },
  { href: "/pricing", label: "Pricing" },
  { href: "/docs", label: "Docs" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e0f11" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link
      href="https://fonts.bunny.net/css?family=albert-sans:400,600,700|hanken-grotesk:400,500,600|geist-mono:400,500"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ apiUrl }}>
      window.PLINTH_API = apiUrl;
    </script>
    {import.meta.env.PUBLIC_CF_BEACON && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON })}
      />
    )}
  </head>
  <body>
    <!--
      THESIS: A quiet night ridge — infrastructure under the thing you ship, not a neon tool dashboard.
      OWN-WORLD: Graphite ground #0e0f11, soft-shadow panels #15171a, stone #8a8f96, snow #f2f1ec, mist #a9b8c6; Albert Sans + Hanken Grotesk + Geist Mono; ink mountain hero, hairlines, no glow.
      STORY: Solo builders get a form URL, catch bin, or repaired JSON free; Pro/Team buy memory and limits through Polar.
      FIRST VIEWPORT: Headline in empty sky above ink ridge; snow CTA Repair broken JSON; SchemaBench on the ridge.
      FORM: brief-pinned night ridge (user references: ink mountains + TURA graphite + OUTER mono metadata; red accent dropped).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true" fill="none">
            <circle cx="16" cy="16" r="12" stroke="#f2f1ec" stroke-width="1.25"></circle>
            <path d="M16 5 L17 14.5 L26 16 L17 17.5 L16 27 L15 17.5 L6 16 L15 14.5 Z" stroke="#f2f1ec" stroke-width="1.25"></path>
            <circle cx="16" cy="16" r="1.6" fill="#f2f1ec"></circle>
          </svg>
          Plinth
        </a>
        <nav aria-label="Primary">
          <ul class="bearings">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + "/") ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href="/guides">Guides</a>
          <a href="/pricing">Pricing</a>
          <a href="/account">Account</a>
          <a href="/compare/formspree">Formspree alternative</a>
          <a href="/compare/webhook-site">Webhook.site alternative</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/legal/privacy">Privacy</a>
          <a href="/legal/terms">Terms</a>
          <a href="mailto:support@plinthrun.com">support@plinthrun.com</a>
        </nav>
        <p>
          Plinth is open-core infrastructure for people who ship alone. Free tiers work without an
          account. Polar is merchant of record.
        </p>
        <p class="colophon">Plinth · open-core · plinthrun.com</p>
      </footer>
    </div>
  </body>
</html>
