---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = "Plinth — forms, webhook catch, JSON repair",
  description = "Open-core infrastructure for solo builders. A form endpoint, an inspectable webhook inbox, and LLM JSON repair — on Cloudflare, billed through Polar.",
  path = "/",
} = Astro.props;

const canonical = new URL(path, "https://plinthrun.com").toString();
const apiUrl = import.meta.env.PUBLIC_API_URL || "https://api.plinthrun.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a5f6b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Geologica:wght@400..700&family=Spline+Sans+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ apiUrl }}>
      window.PLINTH_API = apiUrl;
    </script>
  </head>
  <body>
    <!--
      THESIS: The site is a marine plotting sheet — infrastructure you take bearings on, not a SaaS hero stack.
      OWN-WORLD: Deep chart-teal sea ground, ochre land bands, IHO magenta compass ink, Geologica + Atkinson Hyperlegible + Spline Sans Mono, perforated grid, punched paper plot windows.
      STORY: Solo builders get a working form URL, webhook inbox, or repaired JSON in minutes; paid is memory and limits.
      FIRST VIEWPORT: Magenta compass rose with three rhumb bearings to Forms/Catch/Schema, land band title, live Schema repair plot window as the primary action.
      FORM: marine plotting sheet (grounded list index 4, seed 63f07665).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="13" fill="none" stroke="#d0127a" stroke-width="2"></circle>
            <path d="M16 3 L17.2 14.2 L29 16 L17.2 17.8 L16 29 L14.8 17.8 L3 16 L14.8 14.2 Z" fill="#d0127a"></path>
            <circle cx="16" cy="16" r="2.2" fill="#f3f7f8"></circle>
          </svg>
          Plinth
        </a>
        <nav aria-label="Primary">
          <ul class="bearings">
            <li><a href="/forms">Forms</a></li>
            <li><a href="/catch">Catch</a></li>
            <li><a href="/schema">Schema</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/docs">Docs</a></li>
          </ul>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <nav aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href="/account">Account</a>
          <a href="/compare/formspree">Formspree alternative</a>
          <a href="/compare/webhook-site">Webhook.site alternative</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/legal/privacy">Privacy</a>
          <a href="/legal/terms">Terms</a>
          <a href="mailto:support@plinthrun.com">support@plinthrun.com</a>
        </nav>
        <p>
          Plinth is open-core infrastructure for people who ship alone. Free tiers work without an
          account. Polar is merchant of record.
        </p>
        <div class="legend" aria-hidden="true">
          <span class="sea">Sea</span>
          <span class="land">Land</span>
          <span class="rose">Compass</span>
        </div>
      </footer>
    </div>
  </body>
</html>
