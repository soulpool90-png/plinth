{
  "name": "@plinth/schema",
  "version": "0.1.0",
  "description": "Repair malformed JSON (especially LLM output) and validate it against JSON Schema.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://plinthrun.com/schema",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulpool90-png/plinth.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/soulpool90-png/plinth/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --platform=neutral",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "json",
    "jsonrepair",
    "json-schema",
    "llm",
    "structured-output",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
