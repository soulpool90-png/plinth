{
  "name": "@plinth/catch",
  "version": "0.1.0",
  "description": "Serialize HTTP requests into inspectable webhook snapshots, with optional header redaction.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://plinthrun.com/catch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulpool90-png/plinth.git",
    "directory": "packages/catch"
  },
  "bugs": {
    "url": "https://github.com/soulpool90-png/plinth/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --platform=neutral",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webhooks",
    "http",
    "request-bin"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
